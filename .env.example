# --- WebSocket hub (scripts/ws-hub.js on the Pi) ---
# ปิดการเชื่อม WebSocket ทั้งหมด — สะดวกตอน dev ที่ไม่มี ESP32/hub ต่ออยู่
# (กัน log "WebSocket failed" เด้งซ้ำ). ค่าเริ่มต้นถ้าไม่ตั้ง: เปิด
VITE_SENSOR_ENABLED=false

# URL ของ WebSocket hub ที่เว็บเชื่อมเข้าไป (รับ event จาก ESP32 ทุกตัว +
# ส่งคำสั่งรีเลย์/LED กลับ). ชี้ไปที่ IP ของ Pi (ซึ่งเป็น WiFi AP)
# Pi AP IP ตามค่าเริ่มต้นใน scripts/setup-ap.sh = 192.168.50.1 พอร์ต 8181
# ค่าเริ่มต้นถ้าไม่ตั้ง: ws://localhost:8181/
VITE_SENSOR_WS_URL=ws://192.168.50.1:8181/

# หมายเหตุ: ระดับถัง/ถังเต็มมาจาก ESP32 #3 ผ่าน hub เดียวกันด้านบนแล้ว
# (ไม่มี VITE_BIN_* อีกต่อไป — ปุ่มลัด dev 1-4 ยังสลับสถานะถังเต็มได้เหมือนเดิม)

# --- Model inference server (model_server.py) ---
# URL ที่เว็บ POST รูปไปให้ AI จำแนกประเภทขยะ
# รันเซิร์ฟเวอร์: python model_server.py
# ค่าเริ่มต้นถ้าไม่ตั้ง: http://localhost:8000/classify
VITE_MODEL_API_URL=http://localhost:8000/classify

# --- ไฟกล้อง (Pi GPIO ผ่าน model_server.py /camera) ---
# ไฟบอกประเภทขยะ 4 ดวงอยู่ที่ ESP32 #2 (WebSocket) ส่วนไฟกล้อง 1 ดวง Pi คุมเอง
# URL เว็บใช้เปิด/ปิดไฟกล้อง — ค่าเริ่มต้นอนุมานจาก VITE_MODEL_API_URL (แทน /classify → /camera)
# VITE_CAMERA_API_URL=http://localhost:8000/camera
# ฝั่ง Pi ตั้งขา GPIO + active-low ของไฟกล้องผ่าน env ตอนรัน model_server.py:
#   CAMERA_PIN=24  CAMERA_ACTIVE_LOW=1
